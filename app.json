{
  "expo": {
    "name": "FisioKids",
    "slug": "fisiokids",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.grupo12.fisiokids",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "FisioKids necesita acceder a tus fotos para elegir la foto de perfil.",
          "cameraPermission": "FisioKids usa la cámara para tomar tu foto de perfil."
        }
      ],
      "expo-sharing"
    ]
  }
}
